{
  "componentId": "h5.picker",
  "tool": "pencil",
  "tokenBindings": [
    {
      "token": "component.h5.picker.background",
      "target": "fill.surface"
    }
  ],
  "variantMappings": [
    {
      "variant": "presentation",
      "value": "sheet",
      "target": "layout.presentation.sheet"
    },
    {
      "variant": "presentation",
      "value": "inline",
      "target": "layout.presentation.inline"
    },
    {
      "variant": "columns",
      "value": "single",
      "target": "content.columns.single"
    },
    {
      "variant": "columns",
      "value": "cascading",
      "target": "content.columns.cascading"
    }
  ],
  "slotMappings": [
    {
      "slot": "trigger",
      "target": "content.trigger"
    },
    {
      "slot": "column",
      "target": "content.column"
    },
    {
      "slot": "toolbar",
      "target": "content.toolbar"
    }
  ],
  "stateMappings": [
    {
      "state": "open",
      "target": "state.open"
    },
    {
      "state": "disabled",
      "target": "state.disabled"
    }
  ],
  "assetRefs": [],
  "syncRules": [
    "Map picker presentation to either sheet or inline layout without changing option semantics.",
    "Keep column topology aligned with the columns variant so cascading data stays explicit."
  ]
}
