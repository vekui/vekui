{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vekui Token Document",
  "type": "object",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "tokenPath": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
    },
    "platform": {
      "type": "string",
      "enum": ["pc", "h5", "shared", "neutral"]
    },
    "exportTarget": {
      "type": "string",
      "enum": ["css-vars", "tailwind", "pencil", "figma", "json"]
    },
    "tokenEntry": {
      "type": "object",
      "required": ["name", "path", "kind", "scope", "platforms", "exportTargets"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/tokenPath" },
        "kind": {
          "type": "string",
          "enum": ["color", "radius", "size", "space", "shadow", "opacity", "typography", "duration", "easing", "border", "z-index"]
        },
        "scope": {
          "type": "string",
          "enum": ["semantic", "component", "alias"]
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platform" },
          "minItems": 1,
          "uniqueItems": true
        },
        "value": {},
        "aliasOf": { "$ref": "#/$defs/tokenPath" },
        "component": {
          "type": "string",
          "pattern": "^(pc|h5|neutral)\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 8
        },
        "exportTargets": {
          "type": "array",
          "items": { "$ref": "#/$defs/exportTarget" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["value"] },
            { "required": ["aliasOf"] }
          ]
        },
        {
          "if": {
            "properties": {
              "scope": { "const": "component" }
            },
            "required": ["scope"]
          },
          "then": {
            "required": ["component"]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "required": ["name", "modes", "tokens"],
  "properties": {
    "name": { "$ref": "#/$defs/identifier" },
    "modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "minItems": 1,
      "uniqueItems": true
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tokenEntry" }
    }
  },
  "additionalProperties": false
}
