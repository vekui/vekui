{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veku Token Document",
  "type": "object",
  "required": ["name", "modes", "tokens"],
  "properties": {
    "name": { "type": "string" },
    "modes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "kind", "scope", "platforms", "exportTargets"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "scope": { "type": "string" },
          "platforms": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "value": {},
          "aliasOf": { "type": "string" },
          "component": { "type": "string" },
          "exportTargets": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

